//This function deals only with velocityV coordinates
uint sim2D_to_real1D_VelocityV(uint2 index) {
    uint trueResWidth = resolutionWidth + 2;
    uint x = index.x + 1; //+1 is accounting for the border cell
    uint y = index.y + 1;
    return x * trueResWidth + y;
}

//get the cell to the top of the given edge in real2D 
uint2 sim2D_velocityV_to_real2D_topCell(uint2 index) {
    uint x = index.x;
    uint y = index.y + 1;
    return uint2(x, y);
}
// uint2 sim2D_velocityV_to_real2D_bottomCell(uint2 index) {
//     int x = index.x + 1;
//     int y = index.y + 1;
//     return uint2(x, y);
// }

//get the average velocityH in the center of the velocityV edge between the to given cells; 
float avgH(uint2 topCell) {
    float topLeft     = _velocityH[getCoordH_Left (topCell.x, topCell.y, false)];
    float topRight    = _velocityH[getCoordH_Right(topCell.x, topCell.y, false)];
    float bottomLeft  = _velocityH[getCoordH_Left (topCell.x + 1, topCell.y, false)]; 
    float bottomRight = _velocityH[getCoordH_Right(topCell.x + 1, topCell.y, false)];

    float average = (topLeft + topRight + bottomLeft + bottomRight)* 0.25;

    return average;
}

//calculates the weighted average of vertical speed on "pos"
float getVerticalSpeed(float2 pos) {
    uint2 leftCell = uint2((uint) pos.x, (uint) (pos.y - 0.5)); //casting is rounding down

    //edge center for top left edge
    float2 tl = float2(leftCell.x, leftCell.y + 0.5); 

    //vector going from "tl" to "pos", gives us the distance between the two points
    float2 vec = pos-tl;

    float dx = vec.x;
    float dy = vec.y;
    float sx = 1 - dx;
    float sy = 1 - dy;

    float avg = sx * sy * _velocityV[getCoordV_Up  (leftCell.x, leftCell.y, false)] + 
                dx * sy * _velocityV[getCoordV_Down(leftCell.x, leftCell.y, false)] + 
                sx * dy * _velocityV[getCoordV_Up  (leftCell.x, leftCell.y + 1, false)] + 
                dx * dy * _velocityV[getCoordV_Down(leftCell.x, leftCell.y + 1, false)];

    return avg;
}



//[numthreads(64, 1, 1)]
[numthreads(1, 64, 1)]
void advectVelV(uint3 id: SV_DispatchThreadID){
    uint  velocityV_real1D = sim2D_to_real1D_VelocityV(id.xy);
    uint2 velocityV_real2D = id.xy + 1;
    uint2 topCell_real2D = sim2D_velocityV_to_real2D_topCell(id.xy);
    uint2 bottomCell_real2D = uint2(topCell_real2D.x + 1, topCell_real2D.y);

    if(getType(topCell_real2D.x-1, topCell_real2D.y-1) != 0 &&
       getType(bottomCell_real2D.x-1, bottomCell_real2D.y-1) != 0 
      ) {
        float velV = _velocityV[velocityV_real1D];
        float velH = avgH(topCell_real2D);

        //center of velocityV edge
        float2 edgeCenter = float2(bottomCell_real2D.x, bottomCell_real2D.y + 0.5);

        //calculate where the "particle" at the edge center was in the previous iteration
        float2 newPos = float2(edgeCenter.x - (dt * velV), 
                               edgeCenter.y - (dt * velH));

        _newV[velocityV_real1D] = getVerticalSpeed(newPos);
    }
       
}

float newPressureFill;


[numthreads(8, 8, 1)]
void fillPressure(uint3 id: SV_DispatchThreadID){
    _pressure[getCoordPressure(id.x, id.y, true)] = newPressureFill;
}


RWStructuredBuffer<float> _smoke;
RWStructuredBuffer<float> _newSmoke;

float getSmoke(float2 pos){
    // float2 pos = index.xy - 0.5 - (uint2) index.xy; //center of the cell is (0,0)
    uint2 topLeftCell = (uint2) (pos.xy - 0.5);

    //top left cell center
    float2 tl = topLeftCell + 0.5;

    float2 vec = pos-tl;

    float dx = vec.x;
    float dy = vec.y;
    float sx = dx - 1;
    float sy = dy - 1;

    float avg = sx * sy * _smoke[getCoordPressure(topLeftCell.x,     topLeftCell.y,     false)] + 
                dx * sy * _smoke[getCoordPressure(topLeftCell.x + 1, topLeftCell.y,     false)] + 
                sx * dy * _smoke[getCoordPressure(topLeftCell.x,     topLeftCell.y + 1, false)] + 
                dx * dy * _smoke[getCoordPressure(topLeftCell.x + 1, topLeftCell.y + 1, false)];

    return avg;
}


[numthreads(8, 8, 1)]
void advectSmoke(uint3 id: SV_DispatchThreadID){
    if(getType(id.x, id.y) != 0){

        float velV = (_velocityV[getCoordV_Up(id.x, id.y, true)] + _velocityV[getCoordV_Down(id.x, id.y, true)]) * 0.5;
        float velH = (_velocityH[getCoordH_Left(id.x, id.y, true)] + _velocityH[getCoordH_Right(id.x, id.y, true)]) * 0.5;

        float2 cellCenter = float2(id.x + 0.5, id.y + 0.5) + 1; //+1 to go into true coordinates
        float2 newPos = float2(cellCenter.x - dt * velV, cellCenter.y - dt * velH);

        _newSmoke[getCoordPressure(id.x, id.y, true)] = getSmoke(newPos);
    }

}

[numthreads(8, 8, 1)]
void colorTexture(uint3 id: SV_DispatchThreadID){
    //use smoke as color
    float c = 0;

    //smoke
    // c = _smoke[getCoordPressure(id.x, id.y, true)];
    // c = 1 - c;

    //pressure
    // c = _pressure[getCoordPressure(id.x, id.y, true)];

    //velocityH
    c = _velocityH[getCoordH_Left(id.x, id.y, true)] / 2.0;

    //velocityV
    // c = _velocityV[getCoordV_Up(id.x, id.y, true)] / 2.0;

    //type
    // c =  getType(id.x, id.y - 1);


    // c = (float) id.y/resolutionWidth;
    // int type_left   = getType(id.x, id.y - 1);
    // _velocityH[getCoordH_Left (id.x, id.y, true)];
    // if(getCoordH_Right(id.x, id.y, true) == 2*(128+3) + 1) {
    //     _color[uint2(64,64+id.x)] = float4(1,1,1,0);
    // }
    // c = (float) getCoordH_Left(id.x, id.y, true).x / (resolutionWidth * resolutionHeight);


    //  _color[id.xy] = float4(1, 1, 1, 0.0);
    _color[id.xy] = float4(c, c, c, 0.0);
    if(c < 0)
        _color[id.xy] = float4(c, 1, c, 0.0);
    if(c == 0)
        _color[id.xy] = float4(1, c, c, 0.0);

    
    
}