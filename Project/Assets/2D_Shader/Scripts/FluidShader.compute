RWStructuredBuffer<float> _pressure;
RWStructuredBuffer<int>   _type;        // 0 - wall  | 1 - fluid
RWStructuredBuffer<float> _velocityV;
RWStructuredBuffer<float> _velocityH;
RWTexture2D<float4> _color;


int resolutionWidth;
int resolutionHeight;



int getCoordPressure(int x, int y, bool simulationSpace) {
    if(simulationSpace){
        x++; y++;
    }
    return x * (resolutionWidth+2) + y;
}
int getType(int x, int y){
    if(x < 0 || y < 0 || x >= resolutionHeight || y >= resolutionWidth)
        return 0;
    x++; y++;
    return _type[x * (resolutionWidth+2) + y];
}
int getCoordH_Left(int x, int y, bool simulationSpace) {
    int width = resolutionWidth + 2 + 1;
    if(simulationSpace){
        x++; y++;
    }
    return x * width + y; 
}
int getCoordH_Right(int x, int y, bool simulationSpace) {
    int width = resolutionWidth + 2 + 1;
    if(simulationSpace){
        x++; y++;
    }
    return x * width + y + 1; 
}
int getCoordV_Up(int x, int y, bool simulationSpace) {
    if(simulationSpace){
        x++; y++;
    }
    return x * (resolutionWidth+2) + y;
}
int getCoordV_Down(int x, int y, bool simulationSpace) {
    if(simulationSpace){
        x++; y++;
    }
    return (x + 1) * (resolutionWidth+2) + y;
}



[numthreads(8, 8, 1)]
void solveIncompressibility(uint3 id: SV_DispatchThreadID){

    // if(_type[id.x] == 0)
    //     return;
    if(getType(id.x, id.y) == 0)
        return;

    int type_up     = getType(id.x - 1, id.y); 
    int type_down   = getType(id.x + 1, id.y);
    int type_left   = getType(id.x, id.y - 1);
    int type_right  = getType(id.x, id.y + 1);

    //number orthogonally connected cells that are fluid
    int fluidCells = type_up + type_down + type_left + type_right;

    if(fluidCells == 0)
        return;

    

    //calculate outflow (divergence)
    float div =   _velocityH[getCoordH_Right(id.x, id.y, true)] 
                - _velocityH[getCoordH_Left (id.x, id.y, true)] 
                + _velocityV[getCoordV_Down (id.x, id.y, true)] 
                - _velocityV[getCoordV_Up   (id.x, id.y, true)];

    //divergence average on fluid edges
    float p  = -div / fluidCells;
    // p *= 1.9;
    _pressure[getCoordPressure(id.x, id.y, true)] += 0.01 * p;

    _velocityH[getCoordH_Right(id.x, id.y, true)] += type_right * p;
    _velocityH[getCoordH_Left (id.x, id.y, true)] -= type_left * p;
    _velocityV[getCoordV_Down (id.x, id.y, true)] += type_down * p;
    _velocityV[getCoordV_Up   (id.x, id.y, true)] -= type_up * p;




    // int cellType = _type[getCoordPressure(id.x, id.y, true)];
    // _color[id.xy] = float4(1, 1, 1, 0.0);
    //_color[id.xy] = float4(cellType, cellType, cellType, 0.0);
}


//extrapolates
[numthreads(64, 1, 1)]
void extrapolateH(uint3 id: SV_DispatchThreadID){
    // _velocityH[getCoordH_Left(id.x, 0, false)] = _velocityH[getCoordH_Right(id.x, 0, false)];

    // _velocityH[getCoordH_Right(id.x, resolutionWidth + 1, false)] = _velocityH[getCoordH_Left(id.x, resolutionWidth + 1, false)];

    // _velocityH[getCoordH_Left(0, id.x, false)] = _velocityH[getCoordH_Left(1, id.x, false)];


    //new way
    _velocityH[getCoordH_Left(0, id.x + 1, false)] = _velocityH[getCoordH_Left(1, id.x + 1, false)];
    _velocityV[getCoordV_Up  (0, id.x + 1, false)] = _velocityV[getCoordV_Up  (1, id.x + 1, false)];
    
    _velocityH[getCoordH_Left(resolutionHeight + 1, id.x + 1, false)] = _velocityH[getCoordH_Left(resolutionHeight, id.x + 1, false)];
    _velocityV[getCoordV_Down(resolutionHeight + 1, id.x + 1, false)] = _velocityV[getCoordV_Down(resolutionHeight, id.x + 1, false)];
}

[numthreads(64, 1, 1)]
void extrapolateV(uint3 id: SV_DispatchThreadID){
    // _velocityV[getCoordV_Up(0, id.x, false)] = _velocityV[getCoordV_Down(0, id.x, false)];

    // _velocityV[getCoordV_Down(resolutionHeight + 1, id.x, false)] = _velocityV[getCoordV_Up(resolutionHeight + 1, id.x, false)];

    //new way
    _velocityH[getCoordH_Left(id.x + 1, 0, false)] = _velocityH[getCoordH_Left(id.x + 1, 1, false)];
    _velocityV[getCoordV_Up  (id.x + 1, 0, false)] = _velocityV[getCoordV_Up  (id.x + 1, 1, false)];

    _velocityH[getCoordH_Right(id.x + 1, resolutionWidth + 1, false)] = _velocityH[getCoordH_Right(id.x + 1, resolutionWidth, false)];
    _velocityV[getCoordV_Up   (id.x + 1, resolutionWidth + 1, false)] = _velocityV[getCoordV_Up   (id.x + 1, resolutionWidth, false)];
}

[numthreads(1,1,1)]
void extrapolateCorners(uint3 id: SV_DISPATCHTHREADID) {
    //top left corner
    _velocityV[getCoordV_Up  (0, 0, false)] = _velocityV[getCoordV_Down (0, 0, false)];
    _velocityH[getCoordH_Left(0, 0, false)] = _velocityH[getCoordH_Right(0, 0, false)];

    //top right corner
    _velocityH[getCoordH_Left (0, resolutionWidth + 1, false)] = _velocityH[getCoordH_Left(1, resolutionWidth + 1, false)];
    _velocityV[getCoordV_Up   (0, resolutionWidth + 1, false)] = _velocityV[getCoordV_Down(0, resolutionWidth + 1, false)];
    _velocityH[getCoordH_Right(0, resolutionWidth + 1, false)] = _velocityH[getCoordH_Left(0, resolutionWidth + 1, false)];

    //bottom left corner
    _velocityV[getCoordV_Up  (resolutionHeight + 1, 0, false)] = _velocityV[getCoordV_Up   (resolutionHeight + 1, 1, false)];
    _velocityV[getCoordV_Down(resolutionHeight + 1, 0, false)] = _velocityV[getCoordV_Up   (resolutionHeight + 1, 0, false)];
    _velocityH[getCoordH_Left(resolutionHeight + 1, 0, false)] = _velocityH[getCoordH_Right(resolutionHeight + 1, 0, false)];

    //bottom right corner
    _velocityH[getCoordH_Left (resolutionHeight + 1, resolutionWidth + 1, false)] = _velocityH[getCoordH_Left(resolutionHeight, resolutionWidth + 1, false)];
    _velocityV[getCoordV_Up   (resolutionHeight + 1, resolutionWidth + 1, false)] = _velocityV[getCoordV_Up  (resolutionHeight, resolutionWidth + 1, false)];
    _velocityV[getCoordV_Down (resolutionHeight + 1, resolutionWidth + 1, false)] = _velocityV[getCoordV_Up  (resolutionHeight + 1, resolutionWidth + 1, false)];
    _velocityH[getCoordH_Right(resolutionHeight + 1, resolutionWidth + 1, false)] = _velocityH[getCoordH_Left(resolutionHeight + 1, resolutionWidth + 1, false)];
}


//advect
RWStructuredBuffer<float> _newH;
RWStructuredBuffer<float> _newV;
float dt;

uint sim2D_to_real1D_VelocityH(uint2 index){
    uint trueResWidth = resolutionWidth + 2 + 1;//+1 -> there is one extra H edge per row
    uint x = index.x + 1; //+1 is accounting for the border cell
    uint y = index.y + 1;
    return x * trueResWidth + y;
}

uint2 sim2D_velocityH_to_real2D_leftCell(uint2 index) {
    uint x = index.x + 1;
    uint y = index.y;
    return uint2(x, y);
}

float avgV(uint2 leftCell) {
    float topLeft     = _velocityV[getCoordV_Up  (leftCell.x, leftCell.y, false)];
    float topRight    = _velocityV[getCoordV_Down(leftCell.x, leftCell.y, false)];
    float bottomLeft  = _velocityV[getCoordV_Up  (leftCell.x, leftCell.y + 1, false)]; 
    float bottomRight = _velocityV[getCoordV_Down(leftCell.x, leftCell.y + 1, false)];

    float average = (topLeft + topRight + bottomLeft + bottomRight)* 0.25;
    return average;
}

float getHorizontalSpeed(float2 pos) {
    uint2 topCell = uint2((uint) (pos.x - 0.5), (uint) pos.y); //casting is rounding down

    //edge center for top left edge
    float2 tl = float2(topCell.x + 0.5, topCell.y); 

    //vector going from "tl" to "pos", gives us the distance between the two points
    float2 vec = pos-tl;

    float dx = vec.x;
    float dy = vec.y;
    float sx = 1 - dx;
    float sy = 1 - dy;

    float avg = sx * sy * _velocityH[getCoordH_Left (topCell.x, topCell.y, false)] + 
                dx * sy * _velocityH[getCoordH_Left (topCell.x + 1, topCell.y, false)] + 
                sx * dy * _velocityH[getCoordH_Right(topCell.x, topCell.y, false)] + 
                dx * dy * _velocityH[getCoordH_Right(topCell.x + 1, topCell.y, false)];

    return avg;
}

//[numthreads(1, 64, 1)] //Call dispatch with (height, width / 64, 1)
[numthreads(64, 1, 1)]
void advectVelH(uint3 id: SV_DispatchThreadID){
    uint  velocityH_real1D = sim2D_to_real1D_VelocityH(id.xy);
    uint2 velocityH_real2D = id.xy + 1; 
    uint2 leftCell_real2D = sim2D_velocityH_to_real2D_leftCell(id.xy);
    uint2 rightCell_real2D = uint2(leftCell_real2D.x, leftCell_real2D.y + 1);

    if(getType(leftCell_real2D.x-1, leftCell_real2D.y-1) != 0 &&
       getType(rightCell_real2D.x-1, rightCell_real2D.y-1) != 0
      ) {
        float velV = avgV(leftCell_real2D);
        float velH = _velocityH[velocityH_real1D];

        //center of velocityV edge
        float2 edgeCenter = float2(rightCell_real2D.x + 0.5, rightCell_real2D.y);

        //calculate where the "particle" at the edge center was in the previous iteration
        float2 newPos = float2(edgeCenter.x - (dt * velV), 
                               edgeCenter.y - (dt * velH));

        _newH[velocityH_real1D] = getHorizontalSpeed(newPos);
        // if(newPos.x == (int) newPos.x || newPos.y == (int) newPos.y){
        //     _newH[velocityH_real1D] = 1;
        // }
        
    }
}

